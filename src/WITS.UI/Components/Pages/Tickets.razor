@page "/tickets"
@inject WitsApiClient Api
@inject AuthSession Session
@inject NavigationManager Nav

<PageTitle>Tickets</PageTitle>

<div class="page-heading">
    <h1>Tickets</h1>
    <p class="muted">Track every work item across the queue.</p>
</div>

<div class="view-toolbar">
    <div class="tabs" role="tablist" aria-label="Ticket view">
        <button type="button" role="tab" class="tab @(view == "board" ? "active" : "")"
                aria-selected="@(view == "board")" @onclick="ShowBoard">Board</button>
        <button type="button" role="tab" class="tab @(view == "list" ? "active" : "")"
                aria-selected="@(view == "list")" @onclick="ShowList">List</button>
    </div>

    <div class="toolbar-actions">
        <span class="muted small">
            @totalRecords ticket(s)@(tickets.Count < totalRecords ? $" · showing first {tickets.Count}" : "")
        </span>
        <button type="button" class="btn btn-ghost btn-sm" @onclick="LoadAsync" disabled="@loading">Refresh</button>
    </div>
</div>

@if (loading)
{
    <div class="card empty-state">
        <div><span class="spinner"></span>Loading tickets...</div>
    </div>
}
else if (error is not null)
{
    <div class="alert alert-danger" role="alert">
        <strong>Could not load tickets.</strong>
        <div>@error</div>
    </div>
}
else if (view == "board")
{
    <section class="board" aria-label="Tickets board">
        @foreach (BoardColumn column in columns)
        {
            <section class="board-column" aria-label="@column.Name">
                <header class="column-head">
                    <span class="status-dot @TicketLabels.StatusTone(column.StatusId)" aria-hidden="true"></span>
                    <h2>@column.Name</h2>
                    <span class="count">@column.Tickets.Count</span>
                </header>

                @if (column.Tickets.Count == 0)
                {
                    <div class="column-empty">No tickets here yet.</div>
                }
                else
                {
                    <div class="column-cards">
                        @foreach (Ticket ticket in column.Tickets)
                        {
                            <a class="ticket-card" href="tickets/@ticket.Id">
                                <span class="ticket-title">@ticket.Summary</span>
                                <span class="ticket-meta">Created @ticket.DateCreated.ToString("MMM d") · @ticket.ProjectCode</span>
                                <span class="ticket-foot">
                                    <span class="pill">
                                        <span class="priority-dot @TicketLabels.PriorityTone(ticket.PriorityId)" aria-hidden="true"></span>
                                        @TicketLabels.PriorityName(ticket.PriorityId)
                                    </span>
                                    <span class="pill">@(ticket.Assignee is null ? "Unassigned" : $"Assignee {ticket.Assignee}")</span>
                                    <span class="pill">@ticket.TicketRef</span>
                                </span>
                            </a>
                        }
                    </div>
                }
            </section>
        }
    </section>
}
else if (tickets.Count == 0)
{
    <div class="card empty-state">No tickets found.</div>
}
else
{
    <div class="card table-card">
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Reference</th>
                        <th scope="col">Summary</th>
                        <th scope="col">Status</th>
                        <th scope="col">Priority</th>
                        <th scope="col">Created</th>
                        <th scope="col">Assignee</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Ticket ticket in PagedTickets)
                    {
                        <tr>
                            <td><a class="table-link" href="tickets/@ticket.Id">@ticket.TicketRef</a></td>
                            <td>@ticket.Summary</td>
                            <td><span class="badge @TicketLabels.StatusTone(ticket.StatusId)">@TicketLabels.StatusName(ticket.StatusId)</span></td>
                            <td>
                                <span class="pill">
                                    <span class="priority-dot @TicketLabels.PriorityTone(ticket.PriorityId)" aria-hidden="true"></span>
                                    @TicketLabels.PriorityName(ticket.PriorityId)
                                </span>
                            </td>
                            <td>@ticket.DateCreated.ToString("yyyy-MM-dd")</td>
                            <td>@(ticket.Assignee?.ToString() ?? "Unassigned")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span class="muted small">
                Showing @((page - 1) * PageSize + 1)–@Math.Min(page * PageSize, tickets.Count) of @tickets.Count
                · page @(page) of @TotalPages
            </span>
            <div class="pager">
                <button type="button" class="btn btn-ghost btn-sm" disabled="@(page <= 1)" @onclick="PreviousPage">Previous</button>
                <button type="button" class="btn btn-ghost btn-sm" disabled="@(page >= TotalPages)" @onclick="NextPage">Next</button>
            </div>
        </div>
    </div>
}

@code {
    private const int LoadLimit = 100;
    private const int PageSize = 10;

    private string view = "board";
    private int page = 1;
    private int totalRecords;
    private List<Ticket> tickets = [];
    private List<BoardColumn> columns = [];
    private string? error;
    private bool loading;

    private IEnumerable<Ticket> PagedTickets =>
        tickets.Skip((page - 1) * PageSize).Take(PageSize);

    private int TotalPages => Math.Max((int)Math.Ceiling(tickets.Count / (double)PageSize), 1);

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }

        await LoadAsync();
    }

    private void ShowBoard() => view = "board";

    private void ShowList()
    {
        view = "list";
        page = 1;
    }

    private void PreviousPage() => page--;

    private void NextPage() => page++;

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            // shortcut: the board needs every column in one read; add per-view server paging past 100 tickets.
            PagedResult<Ticket> result = await Api.GetTicketsAsync(1, LoadLimit);
            tickets = [.. result.Items];
            totalRecords = result.TotalRecords;
            page = Math.Min(page, TotalPages);
            BuildBoard();
        }
        catch (WitsApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Session.SignOut();
            Nav.NavigateTo("/login", replace: true);
        }
        catch (WitsApiException exception)
        {
            error = exception.Message;
            tickets = [];
            columns = [];
            totalRecords = 0;
            page = 1;
        }
        catch (HttpRequestException)
        {
            error = "The WITS API is not reachable. Check that it is running and that ApiBaseUrl is correct.";
            tickets = [];
            columns = [];
            totalRecords = 0;
            page = 1;
        }
        finally
        {
            loading = false;
        }
    }

    private void BuildBoard()
    {
        columns = TicketLabels.Statuses
            .Select(status => new BoardColumn(
                status.Id,
                status.Name,
                tickets.Where(ticket => ticket.StatusId == status.Id).ToList()))
            .ToList();

        foreach (IGrouping<int, Ticket> unknown in tickets
            .Where(ticket => !TicketLabels.IsKnownStatus(ticket.StatusId))
            .GroupBy(ticket => ticket.StatusId))
        {
            columns.Add(new BoardColumn(unknown.Key, $"Status {unknown.Key}", [.. unknown]));
        }
    }

    private sealed record BoardColumn(int StatusId, string Name, List<Ticket> Tickets);
}
